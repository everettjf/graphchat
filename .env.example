# Optional. Pi Graph Chat also runs in a fully local demo mode without credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
PI_GRAPH_CHAT_DATA_DIR=.pi-graph-chat
# Where Pi stores coding-agent sessions. Defaults to ~/.pi/agent/sessions.
# PI_CODING_AGENT_SESSION_DIR=
PORT=4317
HOST=127.0.0.1
