{
  "name": "pi-graph-chat",
  "version": "0.3.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "A local-first, graph-native learning workspace built on the Pi agent ecosystem.",
  "license": "MIT",
  "author": "Everett",
  "homepage": "https://github.com/everettjf/pi-graph-chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everettjf/pi-graph-chat.git"
  },
  "bugs": {
    "url": "https://github.com/everettjf/pi-graph-chat/issues"
  },
  "bin": {
    "pi-graph-chat": "scripts/pi-graph-chat.mjs"
  },
  "keywords": [
    "ai",
    "chat",
    "graph",
    "learning",
    "local-first",
    "pi-agent",
    "pi-coding-agent",
    "react"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "start:bun": "bun dist-server/server/index.js",
    "launch": "bun run build && bun ./scripts/pi-graph-chat.mjs",
    "app:build": "bun run build && bun ./packages/bun-menubar/src/cli.ts build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.packages.json",
    "test": "bun x --bun vitest run",
    "test:watch": "bun x --bun vitest",
    "test:e2e": "playwright test",
    "test:providers": "node scripts/provider-smoke.mjs",
    "test:seed-realistic": "node scripts/seed-realistic-learning-data.mjs",
    "test:all": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.packages.json && bun x --bun vitest run && vite build && tsc -p tsconfig.server.json && playwright test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@fastify/static": "^10.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "@xyflow/react": "^12.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.1",
    "lucide-react": "^0.548.0",
    "mermaid": "^11.16.0",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "undici": "^8.9.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.1.15",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
