{
  "name": "@everettjf/graphchat",
  "version": "0.2.0",
  "private": false,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "A local-first, graph-native AI learning workspace.",
  "license": "MIT",
  "author": "Everett",
  "homepage": "https://xnu.app/graphchat/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everettjf/graphchat.git"
  },
  "bugs": {
    "url": "https://github.com/everettjf/graphchat/issues"
  },
  "bin": {
    "graphchat": "./scripts/graphchat.mjs"
  },
  "files": [
    "dist",
    "dist-server",
    "scripts/graphchat.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/CORE_TESTING.md",
    "docs/GRAPHCHAT_FORMAT.md",
    "docs/PRODUCT_VALIDATION.md",
    "docs/V020_TESTING.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "chat",
    "graph",
    "learning",
    "local-first",
    "pi-agent",
    "react"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "docs:preview": "node scripts/serve-docs.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "start:bun": "bun dist-server/server/index.js",
    "graphchat": "bun run build && bun ./scripts/graphchat.mjs",
    "prepack": "npm run build",
    "release:current": "bun run release:validate && bun run build && bun build ./scripts/graphchat.mjs --compile --outfile ./release/graphchat",
    "release:validate": "node scripts/validate-release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:providers": "node scripts/provider-smoke.mjs",
    "test:site": "node scripts/validate-site.mjs",
    "test:all": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vitest run && node scripts/validate-site.mjs && vite build && tsc -p tsconfig.server.json && playwright test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@fastify/static": "^10.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "@xyflow/react": "^12.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.1",
    "lucide-react": "^0.548.0",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "undici": "^7.16.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.1.15",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
